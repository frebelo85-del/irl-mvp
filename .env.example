# Copier vers .env et remplir les valeurs (ne jamais committer .env)
# Supabase → Project Settings → API

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Requis pour getExpoPushTokenAsync (EAS project UUID — expo.dev → Project settings)
EXPO_PUBLIC_EAS_PROJECT_ID=

# Requis uniquement quand liaison Google est activée (Phase H)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- Secrets Edge Functions (Supabase Dashboard → Edge Functions → Secrets) ---
# Ne pas mettre dans .env commité côté client. Pour scripts locaux invoke-* uniquement :
# SUPABASE_URL=              # même valeur que EXPO_PUBLIC_SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY= # Dashboard → API → service_role (jamais dans l'app)
# CRON_SECRET=               # secret partagé cron + auth inter-functions
# EXPO_ACCESS_TOKEN=         # optionnel — expo.dev → Access tokens
